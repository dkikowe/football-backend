NODE_ENV=development
PORT=3000
PUBLIC_API_URL=http://127.0.0.1:3000
DATABASE_URL=postgresql://football:CHANGE_ME@localhost:5432/football_online
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=football:local:
GAME_SERVER_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32
REGIONS_JSON=[{"id":"local","probeUrl":"http://127.0.0.1:3000/v1/ping?region=local"}]
BOT_FILL_SECONDS=12
QUEUE_TIMEOUT_SECONDS=60
SERVER_TIMEOUT_SECONDS=18
MATCH_TIMEOUT_SECONDS=900
RECONNECT_SECONDS=90
JOIN_TICKET_SECONDS=60
ACCESS_TOKEN_SECONDS=3600
REFRESH_TOKEN_DAYS=90
# Explicit trusted reverse-proxy IPs/CIDRs. Empty = ignore forwarded IP headers.
# Railway supplies X-Real-IP; restrict this list to its observed direct edge peer.
TRUSTED_PROXY_CIDRS=
# Public UDP requires DTLS: server owns private PEM; only public CA is advertised.
# Railway protected variable: TRANSPORT_CA_CERTIFICATE = complete multiline public PEM.
# A nonempty TRANSPORT_CA_CERTIFICATE takes precedence over this optional file.
# TRANSPORT_CA_CERTIFICATE_FILE=/run/secrets/transport-ca.pem
# TRANSPORT_SERVER_NAME=game.example.com

# Dedicated Unity process (never embed secret in mobile client)
BACKEND_URL=http://127.0.0.1:3000
FOOTBALL_API_URL=http://127.0.0.1:3000
GAME_SERVER_ID=local-server-1
GAME_REGION=local
GAME_PUBLIC_ADDRESS=127.0.0.1
GAME_LISTEN_ADDRESS=127.0.0.1
GAME_PORT=7777
# GAME_TLS_CERT=/run/secrets/game-cert.pem
# GAME_TLS_KEY=/run/secrets/game-private-key.pem
