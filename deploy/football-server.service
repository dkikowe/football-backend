[Unit]
Description=Football authoritative Unity match server
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=30

[Service]
Type=simple
User=football
Group=football
WorkingDirectory=/opt/football/current
Environment=HOME=/var/lib/football
Environment=XDG_CONFIG_HOME=/var/lib/football/.config
EnvironmentFile=/etc/football/server.env
ExecStart=/opt/football/current/FootballServer -batchmode -nographics -football-server -job-worker-count 1 -logFile -
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
StateDirectory=football
RuntimeDirectory=football
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/football
MemoryHigh=200M
MemoryMax=240M
CPUQuota=75%
TasksMax=128
OOMPolicy=stop
StandardOutput=journal
StandardError=journal
SyslogIdentifier=football-server

[Install]
WantedBy=multi-user.target
