[Unit]
Description=Football isolated Apple Sandbox match server
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10
ConditionPathExists=/etc/football-sandbox/server.env

[Service]
Type=simple
User=football-sandbox
Group=football-sandbox
WorkingDirectory=/opt/football-sandbox/current
Environment=HOME=/var/lib/football-sandbox
Environment=XDG_CONFIG_HOME=/var/lib/football-sandbox/.config
EnvironmentFile=/etc/football-sandbox/server.env
ExecStartPre=/usr/local/libexec/football-sandbox-capacity-check
ExecStart=/opt/football-sandbox/current/FootballServer -batchmode -nographics -football-server -job-worker-count 1 -logFile -
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
StateDirectory=football-sandbox
RuntimeDirectory=football-sandbox
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/football-sandbox
MemoryHigh=200M
MemoryMax=256M
CPUQuota=50%
CPUWeight=20
TasksMax=128
OOMScoreAdjust=500
OOMPolicy=stop
StandardOutput=journal
StandardError=journal
SyslogIdentifier=football-sandbox

[Install]
WantedBy=multi-user.target
